{
  "schemaVersion": 1,
  "module": "compressor",
  "case": "case1",
  "sampleRate": 48000,
  "blockSize": 256,
  "channels": 2,
  "frames": 4800,
  "params": {
    "enabled": true,
    "thresholdDb": -6,
    "ratio": 4,
    "kneeDb": 6,
    "attackMs": 10,
    "releaseMs": 150,
    "makeupDb": 0,
    "outputGain": 1,
    "sidechainEnabled": false
  },
  "tolerance": {
    "kind": "relative",
    "value": 0.000001,
    "floor": 1e-9
  },
  "notes": "阈下直通锚点：输入峰值约 -34dBFS，包络稳态低于下膝点（-6-6/2=-9dBFS），压缩量恒 0、增益恰为 1，期望输出与输入逐位一致。左=低幅 LCG 噪声，右=低幅 440Hz 正弦。帧数非整除（末块 192 帧）。"
}
